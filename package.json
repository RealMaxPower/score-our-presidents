{
  "name": "score-our-presidents",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible editorial framework for scoring US presidencies on 13 categories and 56 sub-criteria, with per-president evidence YAMLs and a published lens-weighting system. Code MIT; spec CC BY-SA 4.0; scoring evidence CC BY 4.0.",
  "license": "MIT",
  "author": "Marshall Cahill <editorial@scoreourpresidents.org>",
  "homepage": "https://www.scoreourpresidents.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealMaxPower/score-our-presidents.git"
  },
  "bugs": {
    "url": "https://github.com/RealMaxPower/score-our-presidents/issues",
    "email": "editorial@scoreourpresidents.org"
  },
  "keywords": [
    "presidential-rankings",
    "political-science",
    "open-data",
    "editorial-methodology",
    "next.js",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate --schema=db/schema.prisma",
    "prepare": "git config core.hooksPath .githooks || true",
    "secret-scan": "bash scripts/secret-scan.sh --all",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:studio": "prisma studio",
    "verify-rankings": "python3 scripts/compute_rankings.py",
    "regress": "node scripts/regression/run.mjs"
  },
  "prisma": {
    "schema": "db/schema.prisma",
    "seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.20.0",
    "@sentry/nextjs": "^10.58.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.1",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.23",
    "prisma": "^5.20.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "8.0.16",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.10.0",
  "pnpm": {
    "overrides": {
      "rollup": ">=3.30.0",
      "postcss": ">=8.5.10",
      "uuid": "^11.1.1",
      "esbuild": ">=0.28.1",
      "vite": "8.0.16",
      "js-yaml": ">=4.3.2 <5",
      "minimatch@3>brace-expansion": ">=1.1.21 <2",
      "minimatch@10>brace-expansion": ">=5.0.12 <6",
      "@babel/core": ">=7.29.6 <8",
      "sharp": ">=0.35.5 <0.36",
      "browserslist": ">=4.28.7 <5",
      "baseline-browser-mapping": ">=2.11.0 <3",
      "source-map-js": ">=1.2.2 <2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    }
  }
}
